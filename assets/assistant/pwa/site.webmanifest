{
  "name": "avd-assistant",
  "short_name": "Assistant",
  "description": "Interactive operations assistant and control-plane companion for avd-ops (Azure Virtual Desktop).",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d1015",
  "theme_color": "#0d1015",
  "icons": [
    {
      "src": "/icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-mark-transparent.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-monochrome-white.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    }
  ]
}
