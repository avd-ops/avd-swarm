// AVD sign-ins in the last 24 hours where Conditional Access was not applied or legacy authentication was used,
// summarized by app display name, CA status, client app used, and result; no user names or IP addresses leave the workspace.
// Columns: learn.microsoft.com/azure/azure-monitor/reference/tables/signinlogs
SigninLogs
| where TimeGenerated > ago(24h)
| where AppDisplayName has_any ("Azure Virtual Desktop", "Windows Virtual Desktop", "Windows Cloud Login", "Azure Remote Desktop")
| extend ConditionalAccessStatus = tostring(column_ifexists("ConditionalAccessStatus", "")),
         ClientAppUsed = tostring(column_ifexists("ClientAppUsed", "")),
         ResultType = tostring(column_ifexists("ResultType", ""))
| where ConditionalAccessStatus in ("notApplied", "failure", "") or (isnotempty(ClientAppUsed) and ClientAppUsed !in ("Browser", "Mobile Apps and Desktop clients"))
| summarize SignIns = count(),
            DistinctCorrelationIds = dcount(CorrelationId),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by AppDisplayName, ConditionalAccessStatus, ClientAppUsed, ResultType
| order by SignIns desc
